{
  "name": "imposteur-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:all": "npm run build:client && tsc",
    "build:client": "cd .. && npm ci && npm run build && rm -rf server/public && cp -r dist server/public",
    "start": "node dist/src/index.js",
    "test": "vitest run --config ../vitest.config.ts",
    "dev": "tsx watch src/index.ts"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
